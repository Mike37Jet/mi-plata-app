# Copia este archivo a `keystore.properties` y rellenalo para poder firmar el
# APK de release. `keystore.properties` esta en .gitignore y NO debe subirse.
#
# El keystore en si tampoco vive en el repositorio: guardalo fuera, por ejemplo
# en ~/.keys/, y haz copia de seguridad. Si lo pierdes no podras actualizar la
# app instalada sin desinstalarla antes, y desinstalar borra la base de datos.
#
# Crear el keystore:
#   keytool -genkeypair -v -keystore ~/.keys/mi-plata.jks \
#     -alias mi-plata -keyalg RSA -keysize 4096 -validity 10000

storeFile=/Users/tu-usuario/.keys/mi-plata.jks
storePassword=
keyAlias=mi-plata
keyPassword=
