<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo del icono: un degradado del verde azulado de la app, mas claro arriba.
  Como la luz de los iconos de Apple, que viene de arriba: da volumen sin
  sombras ni texturas. El degradado va de 18 a 90, que es la parte visible de un
  icono adaptativo (72 de 108); lo de fuera es margen para los efectos del
  launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="18"
                android:endX="54"
                android:endY="90">
                <item android:offset="0" android:color="#FF22B3A0" />
                <item android:offset="1" android:color="#FF005E4E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
