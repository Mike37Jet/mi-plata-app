<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      En Android 12+ la splash la pinta el sistema, no la libreria, y lee los
      atributos de la plataforma. Sin repetirlos aqui con el prefijo android:, el
      circulo del color de la marca detras de las barras no aparecia.
    -->
    <style name="Theme.MiPlata.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_fondo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/icono_fondo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/icono_fondo</item>
        <item name="postSplashScreenTheme">@style/Theme.MiPlata</item>
    </style>
</resources>
